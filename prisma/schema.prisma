// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. Bảng Người dùng
model User {
  id            String          @id @default(uuid())
  email         String          @unique
  name          String?
  password      String?         
  image         String?         
  provider      String?         
  providerId    String? 
  affiliateBy   String?        
  
  // --- THÊM PHỤC VỤ TÍNH NĂNG QUẢN TRỊ ADMIN ---
  status        String          @default("active") // "active" hoặc "deleted"
  vouchers      String[]        @default([])       // Mảng chứa các mã voucher được tặng riêng

  isActive      Boolean         @default(true)
  hasSeenGuide  Boolean         @default(false) 
  hasAcceptedTerms Boolean      @default(false) 
  role          String          @default("user") // "user" hoặc "super_admin"

  // --- 🚀 BẢO MẬT 2FA VÀ THIẾT BỊ TIN CẬY ---
  is2FAEnabled  Boolean         @default(false)
  otpSecret     String?         // Lưu mã OTP tạm thời (đã mã hóa)
  otpExpiresAt  DateTime?       // Hạn sử dụng của mã OTP
  trustedDevices TrustedDevice[]

  workspaces    WorkspaceMember[] 
  createdAt     DateTime        @default(now())
  // Sửa lỗi: Thêm @default(now()) để Prisma không bắt reset database
  updatedAt     DateTime        @default(now()) @updatedAt 
}

// --- 🚀 BẢNG MỚI: QUẢN LÝ THIẾT BỊ TIN CẬY ---
model TrustedDevice {
  id          String   @id @default(uuid())
  userId      String
  deviceName  String
  ipAddress   String
  lastActive  DateTime @default(now())
  isTrusted   Boolean  @default(true) // Nếu false nghĩa là đã bị đăng xuất/chặn
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 2. Bảng Không gian làm việc
model Workspace {
  id             String            @id @default(uuid())
  name           String
  ownerId        String
  phoneNumber    String?           
  
  plan           String            @default("FREE") 
  planExpiry     DateTime?         
  isAutoPay      Boolean           @default(false)  
  balance        Float             @default(0)      
  
  vtpPhone       String?           
  vtpPassword    String?           
  vtpToken       String?           
  vtpShopId      String?           
  senderAddress  String?           
  senderProvince String?           
  senderDistrict String?           

  // --- CÁC CỘT AFFILIATE ---
  referredBy     String?           
  commission     Float             @default(0) 
  totalSignups   Int               @default(0) 
  totalOrders    Int               @default(0) 
  
  members        WorkspaceMember[] 
  socialAccounts SocialAccount[] 
  posts          Post[]            
  products       Product[]         
  inboxMessages  InboxMessage[]    
  socialGroups   SocialGroup[]     
  orders         Order[]           
  transactions   Transaction[]     
  affiliateHistories AffiliateHistory[] 
  createdAt      DateTime          @default(now())
}

// BẢNG MỚI: Lịch sử hoa hồng Affiliate
model AffiliateHistory {
  id            String    @id @default(uuid())
  workspaceId   String    
  sourceId      String    
  amount        Float     
  note          String    
  createdAt     DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
}

// 3. BẢNG GIAO DỊCH
model Transaction {
  id            String   @id @default(uuid())
  workspaceId   String
  amount        Float    
  status        String   @default("pending") 
  description   String   
  planName      String?  
  createdAt     DateTime @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// 4. BẢNG VOUCHER
model Voucher {
  id          String    @id @default(uuid())
  code        String    @unique 
  discount    Float     
  type        String    @default("fixed") 
  minOrder    Float     @default(0)       
  validUntil  DateTime? 
  usageLimit  Int       @default(100)     
  usedCount   Int       @default(0)       
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

// 5. Bảng trung gian Thành viên
model WorkspaceMember {
  id          String    @id @default(uuid())
  userId      String
  workspaceId String
  role        String    @default("admin")
  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

// 6. Bảng Tài khoản mạng xã hội
model SocialAccount {
  id             String    @id @default(uuid())
  workspaceId    String
  platform       String    
  platformId     String    
  accountName    String    
  accessToken    String    @db.Text
  cookies        String?   @db.Text 
  isAiAutoReply  Boolean   @default(false)  
  aiTone         String    @default("friendly") 

  workspace      Workspace @relation(fields: [workspaceId], references: [id])
}

// 7. Bảng Bài đăng
model Post {
  id          String    @id @default(uuid())
  content     String    @db.Text
  productUrl  String?   
  status      String    @default("draft")
  workspaceId String
  isSystemPost Boolean  @default(false) 
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  userId      String?   
  createdAt   DateTime  @default(now())
}

// 8. Bảng Sản phẩm
model Product {
  id             String    @id @default(uuid())
  workspaceId    String
  name           String
  description    String?   @db.Text 
  price          Float?
  imageUrl       String?   
  images         String[]  @default([]) 
  
  productUrl     String?   
  warrantyPeriod String?   

  skuInternal    String    @unique
  totalStock     Int       @default(0)
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  orderItems     OrderItem[] 
}

// 9. Bảng Hộp thư
model InboxMessage {
  id           String   @id @default(uuid())
  workspaceId  String
  platform     String   
  type         String   
  senderName   String
  senderId     String
  content      String   @db.Text
  pageName     String?  
  platformId   String   @unique 
  createdAt    DateTime @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
}

// 10. Bảng Quản lý Hội nhóm
model SocialGroup {
  id           String    @id @default(uuid())
  workspaceId  String
  platform     String    
  groupId      String    
  groupName    String
  pageId       String    
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([groupId, pageId]) 
}

// 11. Bảng Đơn hàng
model Order {
  id              String      @id @default(uuid())
  workspaceId     String
  customerName    String
  customerPhone   String?
  customerAddress String?     
  province        String?     
  district        String?     
  ward            String?     
  totalAmount     Float
  status          String      @default("confirmed")
  shippingCode    String?     
  shippingFee     Float?      
  weight          Int?        @default(500) 
  carrierName     String?     
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  workspace       Workspace   @relation(fields: [workspaceId], references: [id])
}

// 12. Chi tiết đơn hàng
model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// 13. Cấu hình Website
model SystemSetting {
  id            String   @id @default("global")
  websiteName   String?  @default("Dropbuy SaaS")
  logoUrl       String?
  faviconUrl    String?
  hotline       String?
  emailSupport  String?
  announcement  String?  @db.Text 
  maintenance   Boolean  @default(false) 
  updatedAt     DateTime @updatedAt
}

// 14. Thông báo hệ thống
model SystemNotification {
  id          String   @id @default(uuid())
  targetId    String?  
  title       String
  content     String   @db.Text
  type        String   @default("info") 
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// =======================================
// BẢNG QUẢN LÝ KHÁCH HÀNG (Lấy từ Inbox Fanpage)
// =======================================
model Customer {
  id               String   @id @default(uuid())
  name             String   // Tên Facebook của khách
  psid             String   // Page-Scoped ID (ID nhắn tin của khách với Page)
  platformId       String   // ID của Fanpage (Để biết khách nhắn cho page nào)
  workspaceId      String   // ID của Workspace
  status           String   @default("chua_mua") // "chua_mua" hoặc "da_mua"
  lastInteractedAt DateTime @default(now()) 
  
  remarketingTasks RemarketingTask[] 

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// =======================================
// BẢNG HÀNG ĐỢI REMARKETING (Cronjob sẽ đọc bảng này để gửi)
// =======================================
model RemarketingTask {
  id          String   @id @default(uuid())
  customerId  String
  workspaceId String
  prompt      String   
  status      String   @default("pending") // pending | processing | completed | failed
  scheduledAt DateTime // Giờ bắt đầu gửi
  
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}