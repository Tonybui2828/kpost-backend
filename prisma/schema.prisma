// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. Bảng Người dùng
model User {
  id            String          @id @default(uuid())
  email         String          @unique
  name          String?
  password      String?         
  image         String?         
  provider      String?         
  providerId    String?         
  isActive      Boolean         @default(true)
  hasSeenGuide  Boolean         @default(false) 
  hasAcceptedTerms Boolean      @default(false) 
  role          String          @default("user") // "user" hoặc "super_admin"

  workspaces    WorkspaceMember[] 
  createdAt     DateTime        @default(now())
}

// 2. Bảng Không gian làm việc
model Workspace {
  id             String            @id @default(uuid())
  name           String
  ownerId        String
  phoneNumber    String?           
  
  plan           String            @default("free") 
  planExpiry     DateTime?         
  isAutoPay      Boolean           @default(false)  
  balance        Float             @default(0)      
  
  vtpToken       String?           
  vtpShopId      String?           
  senderAddress  String?           
  senderProvince String?           
  senderDistrict String?           
  
  members        WorkspaceMember[] 
  socialAccounts SocialAccount[] 
  posts          Post[]            
  products       Product[]         
  inboxMessages  InboxMessage[]    
  socialGroups   SocialGroup[]     
  orders         Order[]           
  transactions   Transaction[]     
  createdAt      DateTime          @default(now())
}

// 3. BẢNG GIAO DỊCH
model Transaction {
  id            String   @id @default(uuid())
  workspaceId   String
  amount        Float    
  status        String   @default("pending") 
  description   String   
  planName      String?  
  createdAt     DateTime @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// 4. BẢNG VOUCHER
model Voucher {
  id          String    @id @default(uuid())
  code        String    @unique 
  discount    Float     
  type        String    @default("fixed") 
  minOrder    Float     @default(0)       
  expiryDate  DateTime?
  usageLimit  Int       @default(100)     
  usedCount   Int       @default(0)       
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

// 5. Bảng trung gian Thành viên
model WorkspaceMember {
  id          String    @id @default(uuid())
  userId      String
  workspaceId String
  role        String    @default("admin")
  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

// 6. Bảng Tài khoản mạng xã hội
model SocialAccount {
  id             String    @id @default(uuid())
  workspaceId    String
  platform       String    
  platformId     String    
  accountName    String    
  accessToken    String    @db.Text
  cookies        String?   @db.Text 
  isAiAutoReply  Boolean   @default(false)  
  aiTone         String    @default("friendly") 

  workspace      Workspace @relation(fields: [workspaceId], references: [id])
}

// 7. Bảng Bài đăng
model Post {
  id          String    @id @default(uuid())
  content     String    @db.Text
  productUrl  String?   
  status      String    @default("draft")
  workspaceId String
  isSystemPost Boolean  @default(false) 
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  userId      String?   
  createdAt   DateTime  @default(now())
}

// 8. Bảng Sản phẩm (Đã nâng cấp Mô tả và Nhiều ảnh)
model Product {
  id           String    @id @default(uuid())
  workspaceId  String
  name         String
  description  String?   @db.Text // Cho phép nhập mô tả chi tiết sản phẩm rất dài
  price        Float?
  imageUrl     String?   // Vẫn giữ để code cũ không lỗi
  images       String[]  @default([]) // Mảng lưu tối đa 10 đường dẫn ảnh sản phẩm
  productUrl   String?   
  skuInternal  String    @unique
  totalStock   Int       @default(0)
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  orderItems   OrderItem[] 
}

// 9. Bảng Hộp thư
model InboxMessage {
  id           String   @id @default(uuid())
  workspaceId  String
  platform     String   
  type         String   
  senderName   String
  senderId     String
  content      String   @db.Text
  pageName     String?  
  platformId   String   @unique 
  createdAt    DateTime @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
}

// 10. Bảng Quản lý Hội nhóm
model SocialGroup {
  id           String    @id @default(uuid())
  workspaceId  String
  platform     String    
  groupId      String    @unique
  groupName    String
  pageId       String    
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
}

// 11. Bảng Đơn hàng
model Order {
  id              String      @id @default(uuid())
  workspaceId     String
  customerName    String
  customerPhone   String?
  customerAddress String?     
  province        String?     
  district        String?     
  ward            String?     
  totalAmount     Float
  status          String      @default("confirmed")
  shippingCode    String?     
  shippingFee     Float?      
  weight          Int?        @default(500) 
  carrierName     String?     
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  workspace       Workspace   @relation(fields: [workspaceId], references: [id])
}

// 12. Chi tiết đơn hàng
model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// 13. Cấu hình Website
model SystemSetting {
  id            String   @id @default("global")
  websiteName   String?  @default("Dropbuy SaaS")
  logoUrl       String?
  faviconUrl    String?
  hotline       String?
  emailSupport  String?
  announcement  String?  @db.Text 
  maintenance   Boolean  @default(false) 
  updatedAt     DateTime @updatedAt
}

// 14. Thông báo hệ thống
model SystemNotification {
  id          String   @id @default(uuid())
  targetId    String?  
  title       String
  content     String   @db.Text
  type        String   @default("info") 
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}